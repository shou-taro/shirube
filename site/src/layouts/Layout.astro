---
import '@/styles/global.css'
import type { Strings } from '@/i18n'
import { rel } from '@/lib/paths'

interface Props {
  t: Strings
  lang: 'en' | 'ja'
  /** Href of the same page in the other language, for the switcher. */
  switchHref: string
}

const { t, lang, switchHref } = Astro.props

const homeHref = lang === 'en' ? rel('') : rel('ja/')
const docsHref = rel('docs/')
const githubHref = 'https://github.com/shou-taro/shirube'
const pypiHref = 'https://pypi.org/project/shirube/'

// Absolute URLs for social cards (crawlers require absolute, not root-relative).
const ogImage = Astro.site ? new URL(rel('og.png'), Astro.site).href : rel('og.png')
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname

// Small line icons for the footer links (16px, currentColor so they follow the link colour).
// GitHub is the filled mark; the rest are stroked, matching the site's line-icon style.
const strokeSvg = (body: string) =>
  `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${body}</svg>`
const linkIcon = {
  docs: strokeSvg(
    '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
  ),
  github:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2A10 10 0 0 0 8.8 21.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.4-2.2-.2-4.6-1.1-4.6-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.6 1 2.7 0 3.8-2.4 4.7-4.6 4.9.3.4.6.9.6 1.9v2.7c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"/></svg>',
  pypi: strokeSvg('<path d="m12 2 9 5v10l-9 5-9-5V7l9-5Z"/><path d="M3 7l9 5 9-5"/><path d="M12 12v10"/>'),
  licence: strokeSvg('<circle cx="12" cy="8" r="6"/><path d="M8.6 13.4 7 22l5-3 5 3-1.6-8.6"/>'),
}
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={rel('logo.svg')} />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="shirube" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Set the theme before first paint so there is no flash of the wrong palette. -->
    <script is:inline>
      ;(() => {
        try {
          const saved = localStorage.getItem('shirube-site-theme')
          const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
          document.documentElement.classList.toggle('dark', dark)
        } catch {}
      })()
    </script>

    <!-- Boot splash, identical to the app's (see web/index.html): the map "you are here"
         node pulses like a beacon while the page loads, so the site opens the way shirube
         itself does. Inline so it paints before the bundle; held briefly then faded out on
         load (see the script at the end of <body>). -->
    <style is:inline>
      #page-splash {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        background: oklch(1 0 0);
        color: oklch(0.556 0 0);
        transition: opacity 450ms ease;
      }
      html.dark #page-splash {
        background: oklch(0.17 0.014 300);
        color: oklch(0.7 0 0);
      }
      #page-splash.is-hidden {
        opacity: 0;
        pointer-events: none;
      }
      #page-splash svg {
        width: 60px;
        height: 60px;
      }
      #page-splash .node {
        fill: oklch(1 0 0);
      }
      html.dark #page-splash .node {
        fill: oklch(0.17 0.014 300);
      }
      #page-splash .ps-mark {
        animation: ps-in 340ms ease-out both;
      }
      #page-splash .ping {
        animation: ps-ping 1.6s ease-out infinite;
      }
      #page-splash .ps-word {
        font: 500 15px ui-sans-serif, system-ui, -apple-system, sans-serif;
        letter-spacing: 0.01em;
        animation: ps-in 340ms ease-out 80ms both;
      }
      @keyframes ps-in {
        from {
          opacity: 0;
          transform: translateY(4px) scale(0.96);
        }
      }
      @keyframes ps-ping {
        from {
          r: 5.5px;
          opacity: 0.55;
        }
        to {
          r: 14px;
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        #page-splash .ping {
          animation: none;
          opacity: 0;
        }
        #page-splash .ps-mark,
        #page-splash .ps-word {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <div id="page-splash" role="status" aria-label="Loading shirube">
      <div class="ps-mark">
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="12" y1="16" x2="31" y2="11.5" />
          <line x1="12" y1="16" x2="16" y2="35" />
          <line x1="32.5" y1="12.5" x2="36" y2="33" />
          <line x1="16" y1="35" x2="36" y2="33" />
          <circle class="node" cx="12" cy="16" r="4" />
          <circle class="node" cx="16" cy="35" r="4" />
          <circle class="node" cx="36" cy="33" r="4" />
          <circle class="ping" cx="32" cy="11" r="5.5" fill="none" stroke="#a78bfa" stroke-width="2" />
          <circle cx="32" cy="11" r="5.5" fill="#a78bfa" stroke="#a78bfa" />
        </svg>
      </div>
      <div class="ps-word">shirube</div>
    </div>
    <!-- When the splash first paints, so it can be held for a short minimum rather than
         flashing away the instant the page is ready. -->
    <script is:inline>
      window.__pageSplashShownAt = Date.now()
    </script>

    <header class="site-nav">
      <div class="container nav-inner">
        <a class="brand" href={homeHref} aria-label="shirube">
          <img src={rel('logo.svg')} width="30" height="30" alt="" />
          <span>shirube</span>
        </a>
        <nav class="nav-links">
          <a class="nav-ico" href={docsHref}>
            <span class="ni" set:html={linkIcon.docs} />{t.nav.docs}
          </a>
          <a class="nav-ico" href={githubHref} target="_blank" rel="noopener">
            <span class="ni" set:html={linkIcon.github} />{t.nav.github}
          </a>
          <div class="lang-switch" role="group" aria-label="Language">
            {
              lang === 'en' ? (
                <span class="lang-opt is-active" aria-current="true">EN</span>
              ) : (
                <a class="lang-opt" href={switchHref}>EN</a>
              )
            }
            {
              lang === 'ja' ? (
                <span class="lang-opt is-active" aria-current="true">日本語</span>
              ) : (
                <a class="lang-opt" href={switchHref}>日本語</a>
              )
            }
          </div>
          <button id="theme-toggle" class="theme-switch" type="button" role="switch" aria-label="Toggle theme">
            <span class="theme-switch-thumb" aria-hidden="true"></span>
            <svg class="i-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="i-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
          <a class="nav-cta" href="#get-started">{t.nav.getStarted}</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <a class="brand" href={homeHref} aria-label="shirube">
            <img src={rel('logo.svg')} width="28" height="28" alt="" />
            <span>shirube</span>
          </a>
          <p>{t.footer.tagline}</p>
        </div>
        <nav class="footer-links">
          <a href={docsHref}>
            <span class="fi" set:html={linkIcon.docs} />{t.footer.docs}
          </a>
          <a href={githubHref} target="_blank" rel="noopener">
            <span class="fi" set:html={linkIcon.github} />{t.footer.github}
          </a>
          <a href={pypiHref} target="_blank" rel="noopener">
            <span class="fi" set:html={linkIcon.pypi} />{t.footer.pypi}
          </a>
          <a href={`${githubHref}/blob/main/LICENSE`} target="_blank" rel="noopener">
            <span class="fi" set:html={linkIcon.licence} />{t.footer.licence}
          </a>
        </nav>
      </div>
      <div class="container footer-legal">
        <span>© {new Date().getFullYear()} shirube</span>
      </div>
    </footer>

    <script is:inline>
      ;(() => {
        const btn = document.getElementById('theme-toggle')
        btn?.addEventListener('click', () => {
          const dark = document.documentElement.classList.toggle('dark')
          try {
            localStorage.setItem('shirube-site-theme', dark ? 'dark' : 'light')
          } catch {}
        })
      })()
    </script>

    <!-- Fade the boot splash out once the page has loaded, but hold it for at least
         SPLASH_MIN_MS from when it painted so a fast load still shows it briefly. -->
    <script is:inline>
      ;(() => {
        const splash = document.getElementById('page-splash')
        if (splash === null) return
        const SPLASH_MIN_MS = 1000
        const FADE_MS = 450
        const shownAt = window.__pageSplashShownAt || Date.now()
        const hide = () => {
          const remaining = Math.max(0, SPLASH_MIN_MS - (Date.now() - shownAt))
          window.setTimeout(() => {
            splash.classList.add('is-hidden')
            window.setTimeout(() => splash.remove(), FADE_MS)
          }, remaining)
        }
        if (document.readyState === 'complete') hide()
        else window.addEventListener('load', hide)
      })()
    </script>

    <style>
      .site-nav {
        position: sticky;
        top: 0;
        z-index: 40;
        backdrop-filter: saturate(1.4) blur(10px);
        background: color-mix(in oklch, var(--background) 82%, transparent);
        border-bottom: 1px solid var(--hairline);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 60px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 800;
        font-size: 1.05rem;
        text-decoration: none;
        color: var(--foreground);
        letter-spacing: -0.01em;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        font-size: 0.9rem;
      }
      .nav-links a {
        color: var(--muted-foreground);
        text-decoration: none;
        transition: color 0.15s ease;
      }
      .nav-links a:hover {
        color: var(--foreground);
      }
      .nav-ico {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
      }
      .nav-ico .ni {
        display: inline-flex;
      }
      .nav-ico .ni svg {
        width: 15px;
        height: 15px;
      }
      /* A segmented language control: both languages shown side by side, the current one
         filled in, so the choice (and that it toggles) reads at a glance — like the theme
         switch beside it, not a single link that flips to the other language. */
      .lang-switch {
        display: inline-flex;
        align-items: center;
        flex-shrink: 0;
        padding: 2px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--muted);
      }
      .lang-opt {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        line-height: 1.4;
        white-space: nowrap;
        color: var(--muted-foreground);
        text-decoration: none;
        transition:
          color 0.15s ease,
          background 0.15s ease;
      }
      a.lang-opt:hover {
        color: var(--foreground);
      }
      .lang-opt.is-active {
        color: var(--foreground);
        background: var(--card);
        box-shadow: var(--shadow-sm);
      }
      /* A sliding light/dark switch: a thumb that moves under the active icon, both the sun
         and moon always visible so the state (and that it toggles) reads at a glance. */
      .theme-switch {
        position: relative;
        display: grid;
        grid-template-columns: 1fr 1fr;
        place-items: center;
        width: 54px;
        height: 28px;
        padding: 0;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--muted);
      }
      .theme-switch-thumb {
        position: absolute;
        top: 3px;
        left: 3px;
        z-index: 0;
        width: 24px;
        height: 20px;
        border-radius: 999px;
        background: var(--card);
        box-shadow: var(--shadow-sm);
        transition: transform 0.2s ease;
      }
      :global(.dark) .theme-switch-thumb {
        transform: translateX(24px);
      }
      .theme-switch svg {
        position: relative;
        z-index: 1;
        color: var(--muted-foreground);
        transition: color 0.2s ease;
      }
      .theme-switch .i-sun {
        color: var(--foreground);
      }
      :global(.dark) .theme-switch .i-sun {
        color: var(--muted-foreground);
      }
      :global(.dark) .theme-switch .i-moon {
        color: var(--foreground);
      }
      .nav-cta {
        font-weight: 600;
        color: var(--brand-foreground) !important;
        background: var(--brand);
        padding: 0.5rem 0.95rem;
        border-radius: 999px;
        box-shadow: var(--shadow-sm);
      }
      .nav-cta:hover {
        filter: brightness(1.05);
      }
      @media (max-width: 640px) {
        .nav-links {
          gap: 0.55rem;
          font-size: 0.82rem;
        }
        /* Declutter the header: drop the text links and the CTA (the hero carries its own),
           leaving just the compact language and theme controls, which fit at phone widths. */
        .nav-links > a {
          display: none;
        }
      }

      .site-footer {
        margin-top: 5rem;
        border-top: 1px solid var(--hairline);
        padding: 2.5rem 0 3rem;
        background: var(--muted);
      }
      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        justify-content: space-between;
        align-items: flex-start;
      }
      .footer-brand p {
        margin: 0.6rem 0 0;
        color: var(--muted-foreground);
        font-size: 0.9rem;
        max-width: 20rem;
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.2rem;
        font-size: 0.9rem;
      }
      .footer-links a {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--muted-foreground);
        text-decoration: none;
      }
      .footer-links a:hover {
        color: var(--foreground);
      }
      .footer-links .fi {
        display: inline-flex;
        color: var(--muted-foreground);
      }
      .footer-links a:hover .fi {
        color: var(--foreground);
      }
      .footer-legal {
        margin-top: 2rem;
        color: var(--muted-foreground);
        font-size: 0.8rem;
      }
    </style>
  </body>
</html>
